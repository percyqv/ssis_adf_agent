    <DTS:Executable DTS:refId="Package\Actualizar Clientes" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="Actualizar Clientes" DTS:DTSID="{A5555555-5555-5555-5555-555555555555}">
      <DTS:ObjectData><pipeline version="1"><components>
        <component refId="Package\Actualizar Clientes\Origen" componentClassID="Microsoft.OLEDBSource" name="Origen">
          <properties><property name="SqlCommand">SELECT Id, Nombre FROM dbo.Clientes</property><property name="AccessMode">2</property></properties>
          <connections><connection refId="x" connectionManagerID="Package.ConnectionManagers[SRC_OLTP]" connectionManagerRefId="Package.ConnectionManagers[SRC_OLTP]" name="OleDbConnection"/></connections>
        </component>
        <component refId="Package\Actualizar Clientes\Marcar Procesado" componentClassID="Microsoft.OLEDBCommand" name="Marcar Procesado">
          <properties><property name="SqlCommand">UPDATE dbo.Clientes SET Procesado = 1 WHERE Id = ?</property></properties>
          <connections><connection refId="z" connectionManagerID="Package.ConnectionManagers[SRC_OLTP]" connectionManagerRefId="Package.ConnectionManagers[SRC_OLTP]" name="IDbConnection"/></connections>
        </component>
        <component refId="Package\Actualizar Clientes\Destino" componentClassID="Microsoft.OLEDBDestination" name="Destino">
          <properties><property name="OpenRowset">[stg].[Clientes]</property><property name="AccessMode">3</property></properties>
          <connections><connection refId="y" connectionManagerID="Package.ConnectionManagers[DW]" connectionManagerRefId="Package.ConnectionManagers[DW]" name="OleDbConnection"/></connections>
        </component>
      </components><paths>
        <path refId="p1" startId="Package\Actualizar Clientes\Origen.Outputs[Salida]" endId="Package\Actualizar Clientes\Marcar Procesado.Inputs[Entrada]" name="p1"/>
        <path refId="p2" startId="Package\Actualizar Clientes\Marcar Procesado.Outputs[Salida]" endId="Package\Actualizar Clientes\Destino.Inputs[Entrada]" name="p2"/>
      </paths></pipeline></DTS:ObjectData>
    </DTS:Executable>
